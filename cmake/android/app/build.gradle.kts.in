// The application of @SQUARE_ANDROID_NAME@ (made by square_android_app, CMake: do not edit, it is
// made again): a NativeActivity (no Java code), its library lib@SQUARE_ANDROID_TARGET@.so with the
// engine (libSquare.so) and its Vulkan driver (libSqVulkan.so), built by the CMake of the game with
// the NDK and copied in jniLibs (no native build here: Gradle packs them).
// The resources of the game are not in the APK: the target @SQUARE_ANDROID_TARGET@_android_push
plugins {
    id("com.android.application")
}

android {
    namespace = "@SQUARE_ANDROID_PACKAGE@"
    compileSdk = @SQUARE_ANDROID_COMPILE_SDK@
    buildToolsVersion = "@SQUARE_ANDROID_BUILD_TOOLS@"
    // the NDK of the build (its tools strip the libraries in the APK)
    ndkVersion = "@SQUARE_ANDROID_NDK_VERSION@"

    defaultConfig {
        applicationId = "@SQUARE_ANDROID_PACKAGE@"
        minSdk = @SQUARE_ANDROID_MIN_SDK@
        targetSdk = @SQUARE_ANDROID_COMPILE_SDK@
        versionCode = @SQUARE_ANDROID_VERSION_CODE@
        versionName = "@SQUARE_ANDROID_VERSION_NAME@"
        ndk {
            abiFilters += listOf("@SQUARE_ANDROID_ABI@")
        }
    }

    // The configurations of the engine: Debug, Release (debug tools), Retail (no debug tool)
    buildTypes {
        getByName("release") {
            isMinifyEnabled = false
            // not debuggable: no debugger hooks, the drivers in their optimized mode
            isDebuggable = false
            signingConfig = signingConfigs.getByName("debug")
        }
        create("retail") {
            initWith(getByName("release"))
        }
    }

    // the libraries of the build of the game
    sourceSets {
        getByName("main") {
            jniLibs.srcDirs("jniLibs")
        }
    }

    // the libraries as files in a folder of the application: the engine finds its drivers there
    packaging {
        jniLibs {
            useLegacyPackaging = true
        }
    }
}
