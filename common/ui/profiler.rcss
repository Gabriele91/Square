/*
 * profiler.rcss
 * Square
 *
 * The panel of the render profiler (see source/UI/ProfilerPanel.h): on the right of the frame.
 */
body#square_profiler
{
	position: absolute;
	right: 20dp;
	top: 44dp;
	width: 580dp;
	height: auto;
	padding: 10dp 12dp;
	background-color: rgba(10, 14, 22, 210);
	border-radius: 6dp;
	font-family: LatoLatin;
	font-size: 13dp;
	color: #d8dee9;
	z-index: 100;
}
.title { font-weight: bold; color: #ffffff; }
#note { font-weight: normal; color: #9aa6b8; }
.controls { display: block; margin: 4dp 0 6dp 0; color: #9aa6b8; }
.controls input { margin-right: 4dp; }
.controls button
{
	margin-left: 14dp;
	padding: 1dp 8dp;
	color: #d8dee9;
	background-color: rgba(255, 255, 255, 30);
	border-radius: 3dp;
}
.controls button:hover { background-color: rgba(255, 255, 255, 60); }
input.checkbox
{
	width: 12dp;
	height: 12dp;
	border-width: 1dp;
	border-color: #9aa6b8;
	vertical-align: middle;
}
input.checkbox:checked { background-color: #e8a33c; }
.row { display: block; height: 17dp; white-space: nowrap; }
.row.head { color: #9aa6b8; margin-top: 4dp; }
.row span { display: inline-block; text-align: right; }
.row .name  { width: 230dp; text-align: left; overflow: hidden; }
.row .gpu   { width: 110dp; }
.row .cpu   { width: 70dp; }
.row .draws { width: 55dp; }
.row .bar   { width: 80dp; height: 8dp; margin-left: 12dp; background-color: rgba(255, 255, 255, 25); }
.row .bar .fill { display: block; height: 8dp; background-color: #e8a33c; text-align: left; }
.row.head .bar { background-color: transparent; }
