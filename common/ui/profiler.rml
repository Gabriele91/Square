<rml>
<head>
	<title>Render profiler</title>
	<link type="text/rcss" href="profiler.rcss"/>
</head>
<body id="square_profiler">
	<div class="title">RENDER PROFILER <span id="note"></span></div>
	<div class="controls">
		<input type="checkbox" id="shaders"/>cost per shader
		<button id="log">report to log</button>
	</div>
	<div id="rows"></div>
</body>
</rml>
